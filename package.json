{
  "name": "@bearingsoftware/component-test-framework",
  "version": "0.3.9",
  "description": "Reusable Cucumber-based component test framework for APIs, workers, and UIs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./wiremock": {
      "types": "./dist/wiremock.d.ts",
      "default": "./dist/wiremock.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./spa": {
      "types": "./dist/spa.d.ts",
      "default": "./dist/spa.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ],
      "wiremock": [
        "dist/wiremock.d.ts"
      ],
      "postgres": [
        "dist/postgres.d.ts"
      ],
      "redis": [
        "dist/redis.d.ts"
      ],
      "playwright": [
        "dist/playwright.d.ts"
      ],
      "preset": [
        "dist/preset.d.ts"
      ],
      "spa": [
        "dist/spa.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bearingsoftware/component-test-framework.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint-fix": "eslint --fix . && prettier --write 'src/**/*.{ts,tsx}'",
    "test": "run-s test:*",
    "test:lint": "eslint .",
    "test:unit": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build",
    "pub": "node scripts/publish.mjs",
    "publish:restore": "node scripts/restore-after-publish.mjs",
    "test:smoke": "tsc && cucumber-js --config tests/smoke/cucumber.js",
    "test:parallel": "tsc && node -e \"for (const d of ['coverage', '.nyc_output', 'reports']) require('fs').rmSync('tests/parallel/' + d, { recursive: true, force: true })\" && node tests/parallel/prepare.js && cucumber-js --config tests/parallel/cucumber.js && node tests/parallel/check-coverage.js"
  },
  "peerDependencies": {
    "@cucumber/cucumber": ">=11.0.0",
    "@playwright/test": ">=1.0.0",
    "istanbul-lib-coverage": ">=3.0.0",
    "istanbul-lib-report": ">=3.0.0",
    "istanbul-reports": ">=3.0.0",
    "@axe-core/playwright": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "istanbul-lib-coverage": {
      "optional": true
    },
    "istanbul-lib-report": {
      "optional": true
    },
    "istanbul-reports": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "dependencies": {
    "pg": "^8.16.0",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.11"
  }
}
